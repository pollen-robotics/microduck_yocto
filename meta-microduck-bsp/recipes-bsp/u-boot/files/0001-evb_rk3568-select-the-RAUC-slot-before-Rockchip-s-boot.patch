From 023c5b24a76dd133c70ee4731bd971c42b1f41ed Mon Sep 17 00:00:00 2001
From: Fabien Danieau <fabien.danieau@pollen-robotics.com>
Date: Fri, 25 Sep 2026 17:15:39 +0200
Subject: [PATCH] evb_rk3568: select the RAUC slot before Rockchip's boot chain

Prepend an A/B selection to CONFIG_BOOTCOMMAND: walk BOOT_ORDER, take the first
bootname whose BOOT_<name>_LEFT is not "0", decrement and save it, and set
bootargs to root=PARTLABEL=rootfs_<a|b> rauc.slot=<A|B>. Then fall through to
the unchanged RKIMG_BOOTCOMMAND.

It has to be this header, not Kconfig: this file #undefs CONFIG_BOOTCOMMAND
and redefines it, so a CONFIG_BOOTCOMMAND in a defconfig fragment is silently
discarded.

The attempt counter is compared as a string, not with `test 0x${x} -gt 0` as
RAUC's example does: this tree's simple_strtol honours the base 10 that test
passes, so "0x3" parses as 0 and no slot would ever qualify.

A virgin environment seeds BOOT_ORDER="A", not "A B", for now: slot B is never
booted unless a RAUC install puts it first. During bring-up, a few reboots
inside rauc-mark-good's window (or a boot that hangs) spent slot A's attempts
and silently moved the board to B. Put "A B" back when that is fixed --
pollen-robotics/microduck_yocto#24.

Then boot the kernel and DTB in the chosen slot's own /boot (ext4load from
partition 6 or 7, booti), so a RAUC bundle carries its kernel; only a slot
without them falls through to RKIMG_BOOTCOMMAND and the `boot` partition.

Upstream-Status: Inappropriate [microduck RAUC integration]
---
 include/configs/evb_rk3568.h | 67 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 1 deletion(-)

diff --git a/include/configs/evb_rk3568.h b/include/configs/evb_rk3568.h
index f7318c3..d20cdca 100644
--- a/include/configs/evb_rk3568.h
+++ b/include/configs/evb_rk3568.h
@@ -19,8 +19,73 @@
 
 #define CONFIG_SYS_MMC_ENV_DEV		0
 
+/*
+ * microduck: RAUC A/B slot selection, run before Rockchip's own boot chain.
+ * Picks the first bootname in BOOT_ORDER whose BOOT_<name>_LEFT is not zero,
+ * decrements and saves it, and points the kernel at that slot. Adapted from RAUC's
+ * contrib/uboot.sh; docs/agents/rauc.md has the full reasoning. Three traps:
+ *
+ * - "Not zero" is decided by normalising through setexpr and comparing strings,
+ *   never `test 0x${x} -gt 0`: test parses base 10 and this tree's simple_strtol
+ *   honours it, so "0x3" reads as 0. And never against a literal "0": RAUC writes
+ *   "3" but this tree's env_set_hex writes "0x%lx", so U-Boot's own decrements
+ *   read "0x2", "0x1", "0x0" -- and "0x0" != "0" would boot a spent slot forever.
+ * - The DTB must carry no root=: U-Boot merges /chosen/bootargs into this bootargs
+ *   afterwards and a same-key argument replaces rather than appends.
+ * - This lives in the default environment, so a saved one keeps its bootcmd. That
+ *   holds only while U-Boot is updated by reflashing, which also zeros the env.
+ *
+ * Run scripts/test-uboot-bootcmd.sh before changing it; there is no console.
+ */
+#define MICRODUCK_RAUC_SELECT \
+	"setenv bootargs root=PARTLABEL=rootfs_a rauc.slot=A; " \
+	"test -n \"${BOOT_ORDER}\" || setenv BOOT_ORDER \"A\"; " \
+	"test -n \"${BOOT_A_LEFT}\" || setenv BOOT_A_LEFT 3; " \
+	"test -n \"${BOOT_B_LEFT}\" || setenv BOOT_B_LEFT 3; " \
+	"setenv rauc_part; setexpr rauc_zero 0 + 0; " \
+	"for BOOT_SLOT in \"${BOOT_ORDER}\"; do " \
+		"if test \"x${rauc_part}\" = \"x\"; then " \
+			"if test \"x${BOOT_SLOT}\" = \"xA\"; then " \
+				"setexpr rauc_n ${BOOT_A_LEFT} + 0; if test \"x${rauc_n}\" != \"x${rauc_zero}\"; then " \
+					"setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; " \
+					"setenv rauc_part rootfs_a; setenv rauc_slot A; " \
+				"fi; " \
+			"fi; " \
+			"if test \"x${BOOT_SLOT}\" = \"xB\"; then " \
+				"setexpr rauc_n ${BOOT_B_LEFT} + 0; if test \"x${rauc_n}\" != \"x${rauc_zero}\"; then " \
+					"setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; " \
+					"setenv rauc_part rootfs_b; setenv rauc_slot B; " \
+				"fi; " \
+			"fi; " \
+		"fi; " \
+	"done; setenv rauc_n; setenv rauc_zero; " \
+	"if test -n \"${rauc_part}\"; then " \
+		"echo \"RAUC: booting slot ${rauc_slot} (${rauc_part})\"; saveenv; " \
+	"else " \
+		"echo \"RAUC: no slot has attempts left, resetting both to 3\"; " \
+		"setenv BOOT_A_LEFT 3; setenv BOOT_B_LEFT 3; saveenv; reset; " \
+	"fi; " \
+	"setenv bootargs root=PARTLABEL=${rauc_part} rauc.slot=${rauc_slot}; "
+
+/*
+ * microduck: boot the kernel and DTB that live in the chosen slot's rootfs, so a
+ * RAUC bundle carries its own kernel and an update can change it. rootfs_a is GPT
+ * partition 6 and rootfs_b 7 (scripts/check-wks-layout.py checks it; this tree has
+ * no `part number`). /boot/microduck.dtb is the machine's DTB under one name, so
+ * one U-Boot serves both boards. A slot without them falls through to Rockchip's
+ * chain and the kernel in the `boot` partition, as before.
+ */
+#define MICRODUCK_ROOTFS_BOOT \
+	"setenv rauc_partnum 6; " \
+	"if test \"x${rauc_slot}\" = \"xB\"; then setenv rauc_partnum 7; fi; " \
+	"if ext4load ${devtype} ${devnum}:${rauc_partnum} ${kernel_addr_r} /boot/Image && " \
+	"ext4load ${devtype} ${devnum}:${rauc_partnum} ${fdt_addr_r} /boot/microduck.dtb; then " \
+		"echo \"RAUC: kernel from ${rauc_part}\"; booti ${kernel_addr_r} - ${fdt_addr_r}; " \
+	"fi; " \
+	"echo \"RAUC: no kernel in ${rauc_part}, falling back to the boot partition\"; "
+
 #undef CONFIG_BOOTCOMMAND
-#define CONFIG_BOOTCOMMAND RKIMG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND MICRODUCK_RAUC_SELECT MICRODUCK_ROOTFS_BOOT RKIMG_BOOTCOMMAND
 
 #ifdef CONFIG_USB_FUNCTION_DFU
 #define CONFIG_SET_DFU_ALT_INFO
-- 
2.47.3

