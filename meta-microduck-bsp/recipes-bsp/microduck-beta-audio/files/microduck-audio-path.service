[Unit]
Description=Route the RK809 codec to the speaker amplifier
Documentation=file:///etc/alsa/conf.d/60-microduck-beta.conf
# The card appears when the codec probes; sound.target is reached once udev has
# seen the sound cards.
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The NS4150B amp sits on HPL, so the codec must be on its SPK path with an
# external amplifier (rk3566-microduck-beta.dts, &rk809_codec). The rk817 codec
# driver starts on OFF and only a mixer write moves it.
ExecStart=/usr/bin/amixer -q -c rockchiprk809 cset name='Playback Path' SPK
# Then the headphone stage to +9 dB (0..3 in 3 dB steps), after the path: setting
# the path writes AHP_CFG0 back to 0 dB. The board's amp gain is low (110k input
# resistors, about x2.7), and at 0 dB the speaker was quieter than the zero3's and
# sounded thin and nasal. At +9 dB it is louder and fuller, and not distorted
# (checked by ear on a beta, 2026-10-06; a 9 dB lower DAC level did not change
# the character, so it was level, not clipping).
ExecStart=/usr/bin/amixer -q -c rockchiprk809 cset name='HP Output Gain' 3
# And the DAC at the highest value the driver takes (also reset by the path). The
# control reports 0..255 but refuses anything above 252 with EINVAL; about 0.37 dB
# a step. The beta is still about 12 dB quieter than the zero3 at its maximum
# (Seeed's speaker report, 2026-10-14), and quieter sounds thinner, so it gets all
# of it: 236 left about 6 dB unused.
ExecStart=/usr/bin/amixer -q -c rockchiprk809 cset name='DAC Playback Volume' 252,252

[Install]
WantedBy=multi-user.target
