/*
 * microduck beta main board with the Face Board V1.0.
 *
 * The main board is the beta's, so this is rk3566-microduck-beta.dts with its
 * face block swapped. V1.0 replaces the PCA9535 expander and its NPN switches
 * with two constant-current drivers on the same I2C3: an AW21009 (9 channels,
 * 0x20) for the indicator LEDs and an AW2023 (3 channels, 0x45) for the RGB
 * LED, whose INTN takes the expander's GPIO4_C7. The freed GPIO4_D0 carries a
 * new button. Everything else on the face board connector (PDM mic, ToF on
 * SPI3, IMU on I2C3) is wired as on the beta.
 *
 * Channel-to-LED mapping checked on a V1.0 board (sch_261020): the labels
 * below are the V0 face board's names for the same physical LEDs, so the
 * udev rule and robotctl led address them unchanged.
 */

#include "rk3566-microduck-beta.dts"

/ {
	model = "Pollen Robotics microduck beta, face board V1.0";
	compatible = "pollen,microduck-face-board-v1", "pollen,microduck-beta", "rockchip,rk3566";

	/delete-node/ face-leds;

	face-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&face_button>;

		/* Pulled up and debounced (RC) on the face board; pressed is low. */
		face-button {
			label = "face-button";
			linux,code = <KEY_ENTER>;
			gpios = <&gpio4 RK_PD0 GPIO_ACTIVE_LOW>;
		};
	};
};

/delete-node/ &face_gpio;

&i2c3 {
	/* EN is pulled up on the face board; ISET sets the full-scale current. */
	led-controller@20 {
		compatible = "awinic,aw21009";
		reg = <0x20>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@1 { reg = <1>; label = "face:gr1:red"; };
		led@2 { reg = <2>; label = "face:gr1:green"; };
		led@3 { reg = <3>; label = "face:green2:green"; };
		led@4 { reg = <4>; label = "face:green1:green"; linux,default-trigger = "heartbeat"; };
		led@5 { reg = <5>; label = "face:gb:green"; };
		led@6 { reg = <6>; label = "face:gb:blue"; };
		led@7 { reg = <7>; label = "face:gr2:green"; };
		led@8 { reg = <8>; label = "face:gr2:red"; };
		led@9 { reg = <9>; label = "face:cam:red"; };
	};

	led-controller@45 {
		compatible = "awinic,aw2023";
		reg = <0x45>;
		awinic,imax = <1>;
		interrupt-parent = <&gpio4>;
		interrupts = <RK_PC7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&face_gpio_int>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 { reg = <0>; label = "face:rgb:blue"; };
		led@1 { reg = <1>; label = "face:rgb:green"; };
		led@2 { reg = <2>; label = "face:rgb:red"; };
	};
};

&pinctrl {
	face {
		face_button: face-button {
			rockchip,pins = <4 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
