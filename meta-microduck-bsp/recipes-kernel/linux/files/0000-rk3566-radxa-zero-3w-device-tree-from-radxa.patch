 };
 
-&rng {
+&rockchip_suspend {
+	status = "okay";
+};
+
+&i2s0_8ch {
+	status = "okay";
+};
+
+&display_subsystem {
+	status = "okay";
+};
+
+&hdmi {
+	status = "okay";
+	preset_max_hdisplay = <1920>;
+	preset_max_vdisplay = <1080>;
+};
