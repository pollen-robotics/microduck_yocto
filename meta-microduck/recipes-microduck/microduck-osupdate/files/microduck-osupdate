#!/bin/sh
# OS updates from a published channel: the prototype of dashboard-driven OTA.
#
#   microduck-osupdate status        JSON: installed, available, phase, progress, result
#   microduck-osupdate check         fetch the channel's manifest and the build index
#   microduck-osupdate apply [BUILD] download, verify, rauc install, reboot: the
#                                    channel's newest, or a chosen build from the index
#   microduck-osupdate switch        boot the other slot as it is (rollback, no download)
#   microduck-osupdate boot-report   after that reboot: did the new slot come up?
#   microduck-osupdate http          one HTTP request on stdin/stdout (the .socket)
#
# A channel is os/<machine>/<channel>.env in the public bucket, written by
# scripts/publish-os.sh: KEY=value lines. It is downloaded, so it is parsed key by
# key and every value checked against a pattern -- never sourced. The bundle is
# what RAUC verifies (X.509 signature, compatible, the install-check hook); the
# manifest only says which bundle.
# The manifest is unsigned, so whoever can write the bucket can point a robot at
# an older, validly signed bundle. A production board refuses any build older
# than the one it runs (see apply).
# shortcut: a dev board takes the downgrade; it is a bench board. Sign the
# manifest if the bucket's write access ever widens.
set -eu

BASE_URL=https://huggingface.co/buckets/pollen-robotics/microduck-os/resolve
# A production board is one whose RAUC keyring lacks the development CA, which
# only the dev image adds (rauc-conf-dev-ca). It can install nothing but
# production-signed bundles, and only stable carries those.
production() { [ ! -e /usr/lib/rauc/ca-dev.cert.pem ]; }
if production; then CHANNEL=stable; else CHANNEL=dev; fi
# Root-owned local configuration, so sourcing it is fine (unlike the manifest).
[ ! -r /etc/microduck-osupdate.conf ] || . /etc/microduck-osupdate.conf
STATE=/var/lib/robot/osupdate
mkdir -p "$STATE"

say() { printf '%s\n' "$*" > "$STATE/message"; echo "$*" >&2; }
phase() { printf '%s\n' "$1" > "$STATE/phase"; }
fail() { say "$*"; phase idle; exit 1; }
matches() { printf '%s' "$1" | grep -Eqx -- "$2"; }

# status reads it seven times and the page polls status, so status sets RAUC_JSON
# once: each rauc call costs ~50 ms CPU here and ~70 ms in rauc.service (measured
# on a Zero 3W: a status went from ~1.4 s CPU in total to ~0.7 s).
rauc_json() {
	if [ -n "${RAUC_JSON:-}" ]; then printf '%s\n' "$RAUC_JSON"
	else rauc status --detailed --output-format=json 2>/dev/null; fi
}
machine() { rauc_json | grep -o '"compatible":"[^"]*"' | head -n 1 | cut -d'"' -f4; }
# The booted slot's object, one per line after the split. "build" is the bundle's
# RAUC_BUNDLE_BUILD, recorded by RAUC at install; a flashed slot has none.
booted_slot_json() { rauc_json | sed 's/{"rootfs\./\n&/g' | grep '"state":"booted"' || true; }
rauc_build() { booted_slot_json | grep -o '"build":"[0-9]*"' | head -n 1 | cut -d'"' -f4; }
# A flashed slot's id is the one its image carries (microduck-image.bb), empty on
# an image from before that.
installed_build() {
	b=$(rauc_build)
	[ -n "$b" ] || b=$(sed -n 's/^BUILD_ID="\([0-9]\{14\}\)"$/\1/p' /etc/os-release)
	echo "$b"
}
booted_name() { booted_slot_json | grep -o '"bootname":"[^"]*"' | head -n 1 | cut -d'"' -f4; }
booted_good() { booted_slot_json | grep -q '"boot_status":"good"'; }
# The other slot: the one that is not booted (two slots, so exactly one).
other_slot_json() { rauc_json | sed 's/{"rootfs\./\n&/g' | grep '"bootname"' | grep -v '"state":"booted"' || true; }
other_build() { other_slot_json | grep -o '"build":"[0-9]*"' | head -n 1 | cut -d'"' -f4; }
other_name() { other_slot_json | grep -o '"bootname":"[^"]*"' | head -n 1 | cut -d'"' -f4; }
other_good() { other_slot_json | grep -q '"boot_status":"good"'; }
other_installed() { other_slot_json | grep -o '"installed":{"timestamp":"[^"]*"' | head -n 1 | cut -d'"' -f6; }

# field FILE KEY: the first KEY= line's value.
field() { sed -n "s/^$2=//p" "$1" | head -n 1; }

board_machine() {
	m=$(machine)
	matches "$m" '[a-z0-9-]{1,40}' || fail "cannot tell this board's machine from rauc status"
}

# load_manifest REL DEST: fetch os/<machine>/REL (a channel file, or builds/<b>.env),
# check every field, and write the checked values to DEST in the same KEY=value
# shape. Only DEST is ever read back.
load_manifest() {
	tmp=$STATE/manifest.part
	# -L: the bucket answers with a redirect to its CDN.
	curl -fsSL --max-time 30 -o "$tmp" "$BASE_URL/os/$m/$1" ||
		fail "no manifest at $BASE_URL/os/$m/$1"
	version=$(field "$tmp" VERSION); build=$(field "$tmp" BUILD); url=$(field "$tmp" URL)
	sha256=$(field "$tmp" SHA256); size=$(field "$tmp" SIZE); compat=$(field "$tmp" COMPATIBLE)
	rm -f "$tmp"
	matches "$version" '[0-9A-Za-z.+_-]{1,64}' || fail "manifest: bad VERSION"
	matches "$build" '[0-9]{14}' || fail "manifest: bad BUILD"
	matches "$sha256" '[0-9a-f]{64}' || fail "manifest: bad SHA256"
	matches "$size" '[0-9]{1,12}' || fail "manifest: bad SIZE"
	[ "$compat" = "$m" ] || fail "manifest is for '$compat', this board is '$m'"
	case "$url" in "$BASE_URL/os/$m/"*) ;; *) fail "manifest: URL outside $BASE_URL/os/$m/" ;; esac
	matches "$url" '[A-Za-z0-9:/._%+-]{1,300}' || fail "manifest: bad URL"
	printf 'VERSION=%s\nBUILD=%s\nURL=%s\nSHA256=%s\nSIZE=%s\n' \
		"$version" "$build" "$url" "$sha256" "$size" > "$2"
}

# The index, os/<machine>/index.txt: "<channel> <build> <version>" per published
# build, newest last. Lines that do not match are dropped, not trusted.
load_index() {
	tmp=$STATE/index.part
	if curl -fsSL --max-time 30 -o "$tmp" "$BASE_URL/os/$m/index.txt"; then
		grep -Ex '[a-z0-9-]{1,40} [0-9]{14} [0-9A-Za-z.+_-]{1,64}' "$tmp" | tail -n 200 > "$STATE/index.txt" || true
	fi
	rm -f "$tmp"
}

check() {
	board_machine
	load_index
	load_manifest "$CHANNEL.env" "$STATE/available.env"
	say "checked $CHANNEL: $(field "$STATE/available.env" VERSION)"
}

# apply [BUILD]: the channel's newest build, or a chosen one from the index --
# a dev branch, a given stable release, or an older build to go back to. Choosing
# is an explicit act, so an older build is allowed here -- on a dev board only.
apply() {
	exec 9> "$STATE/lock"
	flock -n 9 || fail "an update is already running"
	phase checking
	board_machine
	if [ -n "${1:-}" ]; then
		matches "$1" '[0-9]{14}' || fail "bad build id"
		load_manifest "builds/$1.env" "$STATE/target.env"
	else
		check
		cp "$STATE/available.env" "$STATE/target.env"
	fi
	a=$STATE/target.env
	build=$(field "$a" BUILD); url=$(field "$a" URL); sha256=$(field "$a" SHA256)
	size=$(field "$a" SIZE); version=$(field "$a" VERSION)
	installed=$(installed_build)
	[ "$build" != "$installed" ] || fail "build $build is already running"
	# Build ids are UTC timestamps, so newer is larger. A flashed slot has none.
	# Going back on a production board is `switch`, to the other slot as it is.
	if production && [ -n "$installed" ] && [ "$build" -lt "$installed" ]; then
		fail "build $build is older than the installed $installed; this board does not downgrade"
	fi
	# Already in the other slot, and good: boot it rather than download it again.
	if [ "$build" = "$(other_build)" ] && other_good; then
		switch_slot "$version"
	fi

	# On the data partition: 7 GiB free, where the 2 GiB rootfs has ~1.
	phase downloading; say "downloading $version"
	part=$STATE/bundle.raucb.part
	[ ! -f "$part" ] || [ "$(cat "$STATE/bundle.build" 2>/dev/null)" = "$build" ] || rm -f "$part"
	echo "$build" > "$STATE/bundle.build"
	curl -fsSL --retry 5 --retry-delay 5 -C - -o "$part" "$url" || fail "download failed (it resumes on the next try)"
	[ "$(wc -c < "$part")" = "$size" ] || { rm -f "$part"; fail "downloaded size is not $size"; }
	[ "$(sha256sum "$part" | cut -d' ' -f1)" = "$sha256" ] || { rm -f "$part"; fail "sha256 mismatch"; }

	phase installing; say "installing $version"
	from=$(booted_name)
	if ! rauc install "$part" > "$STATE/rauc.log" 2>&1; then
		rm -f "$part"
		hint=; production && hint=" (this board takes production-signed stable builds only)"
		fail "rauc refused it: $(grep -v '^ *[0-9]*% ' "$STATE/rauc.log" | tail -n 1)$hint"
	fi
	rm -f "$part"
	printf 'VERSION=%s\nBUILD=%s\nFROM=%s\n' "$version" "$build" "$from" > "$STATE/pending.env"

	phase rebooting; say "installed $version; rebooting into it"
	sync
	sleep 3   # so a dashboard polling status sees "rebooting" before the link drops
	systemctl reboot
}

# Boot the other slot as it is: the rollback that needs no download. Only a slot
# RAUC last saw good; the health gate then judges this boot like any other.
switch_slot() {
	other_good || fail "slot $(other_name) is not marked good; not booting it"
	from=$(booted_name)
	rauc status mark-active other > "$STATE/rauc.log" 2>&1 || fail "rauc would not activate slot $(other_name)"
	label=${1:-$(other_build)}
	printf 'VERSION=%s\nBUILD=%s\nFROM=%s\nHOW=switched\n' "${label:-the flashed image}" "$(other_build)" "$from" > "$STATE/pending.env"
	phase rebooting; say "booting slot $(other_name) (${label:-the flashed image})"
	sync; sleep 3; systemctl reboot
	exit 0
}

switch() {
	exec 9> "$STATE/lock"
	flock -n 9 || fail "an update is already running"
	switch_slot ""
}

boot_report() {
	p=$STATE/pending.env
	[ -f "$p" ] || exit 0
	build=$(field "$p" BUILD); version=$(field "$p" VERSION); from=$(field "$p" FROM)
	how=$(field "$p" HOW); how=${how:-updated}
	# RAUC's record, like the BUILD that switch_slot wrote: empty for a flashed slot.
	if [ "$(rauc_build)" = "$build" ]; then
		if booted_good; then r="$how to $version"; else r="booted $version, but it did not pass the health check"; fi
	else
		r="rolled back: $version did not come up, back on slot $(booted_name)"
		[ "$(booted_name)" = "$from" ] || r="$r (was on $from)"
	fi
	printf '%s\n' "$r" > "$STATE/result"; say "$r"; phase idle; rm -f "$p"
}

jstr() { printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

status() {
	RAUC_JSON=$(rauc_json)
	ph=$(cat "$STATE/phase" 2>/dev/null || echo idle)
	progress=0
	a=$STATE/available.env
	if [ "$ph" = downloading ] && [ -f "$a" ] && [ -f "$STATE/bundle.raucb.part" ]; then
		size=$(field "$a" SIZE); have=$(wc -c < "$STATE/bundle.raucb.part")
		[ "${size:-0}" -gt 0 ] && progress=$((have * 100 / size))
	fi
	avail=null
	if [ -f "$a" ]; then
		avail="{\"version\":$(jstr "$(field "$a" VERSION)"),\"build\":$(jstr "$(field "$a" BUILD)"),\"size\":$(field "$a" SIZE)}"
	fi
	og=false; other_good && og=true
	other="{\"slot\":$(jstr "$(other_name)"),\"build\":$(jstr "$(other_build)"),\"good\":$og,\"installed\":$(jstr "$(other_installed)")}"
	# The index lines passed load_index's pattern, so they hold no quote to escape.
	builds=$(awk '{printf "%s{\"channel\":\"%s\",\"build\":\"%s\",\"version\":\"%s\"}", (NR > 1 ? "," : ""), $1, $2, $3}' "$STATE/index.txt" 2>/dev/null || true)
	prod=false; production && prod=true
	printf '{"machine":%s,"channel":%s,"production":%s,"slot":%s,"installed_build":%s,"available":%s,"other":%s,"builds":[%s],"phase":%s,"progress":%d,"message":%s,"last_result":%s}\n' \
		"$(jstr "$(machine)")" "$(jstr "$CHANNEL")" "$prod" "$(jstr "$(booted_name)")" \
		"$(jstr "$(installed_build)")" "$avail" "$other" "$builds" "$(jstr "$ph")" "$progress" \
		"$(jstr "$(cat "$STATE/message" 2>/dev/null || true)")" \
		"$(jstr "$(cat "$STATE/result" 2>/dev/null || true)")"
}

respond() {  # code reason content-type body
	printf 'HTTP/1.0 %s %s\r\nContent-Type: %s\r\nContent-Length: %d\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n%s' \
		"$1" "$2" "$3" "$(printf '%s' "$4" | wc -c)" "$4"
}

http() {
	IFS=' ' read -r method path _ || exit 0
	method=$(printf '%s' "$method" | tr -d '\r'); path=$(printf '%s' "$path" | tr -d '\r')
	marked=0
	while IFS= read -r line; do
		line=$(printf '%s' "$line" | tr -d '\r')
		[ -n "$line" ] || break
		case "$line" in [Xx]-[Mm]icroduck:*) marked=1 ;; esac
	done
	# State-changing requests need the X-Microduck header: a page on another origin
	# cannot add it without a CORS preflight, which this never answers, so a web
	# page cannot drive a robot on the visitor's LAN into an update.
	# shortcut: no authentication beyond that; anyone on the LAN can update the
	# robot. Production: the HF-authenticated dashboard path, or a pairing PIN.
	# One query parameter, build=<14 digits>; anything else in the query is ignored.
	query=; case "$path" in *\?*) query=${path#*\?}; path=${path%%\?*} ;; esac
	build=$(printf '%s' "$query" | tr '&' '\n' | sed -n 's/^build=//p' | head -n 1)
	case "$method $path" in
	"GET /" | "GET /index.html")
		respond 200 OK "text/html; charset=utf-8" "$(cat /usr/share/microduck-osupdate/index.html)" ;;
	"GET /api/status")
		respond 200 OK application/json "$(status)" ;;
	"POST /api/check" | "POST /api/apply" | "POST /api/switch")
		if [ "$marked" != 1 ]; then respond 403 Forbidden text/plain "missing X-Microduck header"; exit 0; fi
		if [ -n "$build" ] && ! matches "$build" '[0-9]{14}'; then
			respond 400 "Bad Request" text/plain "build must be 14 digits"; exit 0
		fi
		if [ "$path" = /api/check ]; then
			# A subshell: check's fail() exits, and that must not end this request
			# before it is answered -- the failure is in status's message.
			(check) > /dev/null 2>&1 || true
			respond 200 OK application/json "$(status)"
		elif systemctl is-active -q microduck-osupdate-apply.service; then
			respond 409 Conflict application/json "$(status)"
		else
			if [ "$path" = /api/switch ]; then set -- switch; else set -- apply $build; fi
			systemd-run -q --unit=microduck-osupdate-apply --collect /usr/bin/microduck-osupdate "$@"
			respond 202 Accepted application/json "$(status)"
		fi ;;
	*)
		respond 404 "Not Found" text/plain "not found" ;;
	esac
}

case "${1:-}" in
status) status ;;
check) check ;;
apply) apply "${2:-}" ;;
switch) switch ;;
boot-report) boot_report ;;
http) http ;;
*) echo "usage: $0 status|check|apply [BUILD]|switch|boot-report|http" >&2; exit 2 ;;
esac
